{
  "id": "/",
  "name": "Vault Web",
  "short_name": "Vault Web",
  "description": "Your private files and workspace",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    { "name": "Cloud files", "url": "/cloud" },
    { "name": "Receive a share", "url": "/share-target" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/pdf",
            ".pdf",
            ".txt",
            ".md",
            ".png",
            ".jpg"
          ]
        }
      ]
    }
  }
}
